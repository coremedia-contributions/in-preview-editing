  "main": "dist/coremedia.ipe.plugin.iife.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "publish:snapshot": "pnpm publish --tag snapshot --no-git-checks --force",
    "publish:release": "pnpm publish --no-git-checks --registry https://npm.coremedia.io/"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@coremedia/studio-client.common-icons": "^2.1.0",
    "clsx": "^2.1.1",
